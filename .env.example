# Copia a .env.local y rellena con los valores de tu proyecto Supabase
# (Dashboard → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# URL pública del sitio (para los enlaces de los emails de confirmación)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cliente (bajo privilegio): PUBLISHABLE key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TU-CLAVE
# Proyectos antiguos (fallback): anon key legacy
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# SERVIDOR (privilegio elevado, NUNCA en el cliente ni con NEXT_PUBLIC_):
# SECRET key (sb_secret_...). La usa el simulador para escribir partidos.
SUPABASE_SECRET_KEY=sb_secret_TU-CLAVE
# Proyectos antiguos (fallback): service_role key
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
